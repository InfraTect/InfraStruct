<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs 예외 목록.

  규칙을 통째로 끄기 전에 "이 클래스에서만" 좁게 예외를 준다. 한 곳뿐이면 코드에
  @SuppressFBWarnings 를 쓰는 쪽이 낫다 (ProviderResource 가 그 예다). 같은 패턴이 여러 파일에
  반복될 때만 여기로 올린다.
-->
<FindBugsFilter>

    <!--
      스캔 test fixture 의 자원 필드.

      이 필드들은 (1) 사용자가 자원을 선언하는 방식 그대로 public 이고, (2) 값은 initializer block 이
      채우며, (3) 읽는 쪽은 ResourceScanner 의 reflection 이다. 정적 분석에는 셋 다 안 보여서
      "안 읽는 필드 / 안 쓰는 필드"로 오탐한다. ProviderResource 가 @SuppressFBWarnings 로 억제한 것과
      같은 건인데, fixture 는 8개 파일에 같은 패턴이 반복되어 여기로 올렸다.
    -->
    <Match>
        <Class name="~com\.infrastruct\.fixture\..*"/>
        <Bug pattern="URF_UNREAD_PUBLIC_OR_PROTECTED_FIELD,
                      UUF_UNUSED_PUBLIC_OR_PROTECTED_FIELD,
                      UWF_UNWRITTEN_PUBLIC_OR_PROTECTED_FIELD,
                      NP_UNWRITTEN_PUBLIC_OR_PROTECTED_FIELD"/>
    </Match>

</FindBugsFilter>
